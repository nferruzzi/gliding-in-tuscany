<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or site.description[lang] }}">
  <meta name="keywords" content="{{ keywords or site.keywords[lang] }}">
  <title>{{ title or site.title[lang] }}</title>

  {# Canonical URL #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {# Open Graph #}
  <meta property="og:title" content="{{ title or site.title[lang] }}">
  <meta property="og:description" content="{{ description or site.description[lang] }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/images/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="{{ lang }}_{{ 'IT' if lang == 'it' else ('GB' if lang == 'en' else 'DE') }}">
  <meta property="og:site_name" content="Gliding in Tuscany">

  {# Twitter Cards #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.title[lang] }}">
  <meta name="twitter:description" content="{{ description or site.description[lang] }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/images/og-image.jpg">

  {# JSON-LD Structured Data #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Gliding in Tuscany - Aeroagriturismo Podere S.Apollonia",
    "description": "{{ site.description[lang] }}",
    "url": "{{ site.url }}",
    "telephone": "{{ site.contact.phone }}",
    "email": "{{ site.contact.email }}",
    "image": "{{ site.url }}/assets/images/og-image.jpg",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.contact.address.street }}",
      "addressLocality": "{{ site.contact.address.city }}",
      "addressRegion": "{{ site.contact.address.province }}",
      "postalCode": "{{ site.contact.address.postalCode }}",
      "addressCountry": "{{ site.contact.address.country }}"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ site.contact.geo.latitude }},
      "longitude": {{ site.contact.geo.longitude }}
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "08:00",
      "closes": "20:00"
    },
    "priceRange": "€€"
  }
  </script>

  {# BreadcrumbList JSON-LD #}
  {% if breadcrumb %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ site.url }}/{{ lang }}/"
      }{% for crumb in breadcrumb %},
      {
        "@type": "ListItem",
        "position": {{ loop.index + 1 }},
        "name": "{{ crumb.name }}",
        "item": "{{ site.url }}{{ crumb.url }}"
      }{% endfor %}
    ]
  }
  </script>
  {% endif %}

  {# Service JSON-LD per pagine volo #}
  {% if serviceSchema %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Volo a Vela in Toscana",
    "description": "Voli introduttivi in aliante sopra le colline della Toscana. Lancio col verricello e aerotraino con piloti istruttori esperti.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Gliding in Tuscany - Aeroagriturismo Podere S.Apollonia",
      "url": "{{ site.url }}",
      "telephone": "{{ site.contact.phone }}",
      "image": "{{ site.url }}/assets/images/og-image.jpg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ site.contact.address.street }}",
        "addressLocality": "{{ site.contact.address.city }}",
        "addressRegion": "{{ site.contact.address.province }}",
        "postalCode": "{{ site.contact.address.postalCode }}",
        "addressCountry": "{{ site.contact.address.country }}"
      },
      "priceRange": "€€"
    },
    "areaServed": {
      "@type": "Place",
      "name": "Toscana, Italia"
    },
    "serviceType": "Volo a Vela",
    "offers": [
      {
        "@type": "Offer",
        "name": "Lancio al Verricello",
        "price": "30",
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "name": "Volo Introduttivo 700m",
        "price": "110",
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "name": "Volo Introduttivo 1000m",
        "price": "140",
        "priceCurrency": "EUR"
      }
    ]
  }
  </script>
  {% endif %}

  {# Favicon placeholder #}
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">

  {# Preload font più usati per parallelizzare download #}
  <link rel="preload" href="/assets/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/Inter-Bold.woff2" as="font" type="font/woff2" crossorigin>

  {# CSS inline per eliminare richiesta render-blocking #}
  <style>
  @font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url('/assets/fonts/Inter-Regular.woff2') format('woff2')}
  @font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url('/assets/fonts/Inter-Medium.woff2') format('woff2')}
  @font-face{font-family:'Inter';font-style:normal;font-weight:600;font-display:swap;src:url('/assets/fonts/Inter-SemiBold.woff2') format('woff2')}
  @font-face{font-family:'Inter';font-style:normal;font-weight:700;font-display:swap;src:url('/assets/fonts/Inter-Bold.woff2') format('woff2')}
  @font-face{font-family:'Font Awesome 6 Free';font-style:normal;font-weight:900;font-display:block;src:url('/assets/fonts/fa-solid-900.woff2') format('woff2')}
  .fa-solid,.fas{font-family:'Font Awesome 6 Free';font-weight:900;font-style:normal;font-variant:normal;text-rendering:auto;line-height:1;display:inline-block;-moz-osx-font-smoothing:grayscale;-webkit-font-smoothing:antialiased}
  .fa-circle-info::before{content:"\f05a"}.fa-users::before{content:"\f0c0"}.fa-person-biking::before{content:"\f84a"}.fa-water::before{content:"\f773"}.fa-mountain-city::before{content:"\e52e"}.fa-martini-glass-citrus::before{content:"\f561"}
  {{ "/css/output.css" | inlineCSS | safe }}
  </style>

  {# GLightbox CSS - solo nelle pagine che lo usano #}
  {% if glightbox %}
  <link rel="stylesheet" href="/assets/vendor/glightbox.min.css">
  {% endif %}

  {# Alternate languages #}
  {% if alternates %}
  {% for language in site.languages %}
  <link rel="alternate" hreflang="{{ language }}" href="{{ site.url }}{{ alternates[language] }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ alternates[site.defaultLanguage] }}">
  {% endif %}
</head>
<body class="flex flex-col min-h-screen">
  {% include "header.njk" %}

  <main class="flex-grow">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  {# GLightbox JS - solo nelle pagine che lo usano #}
  {% if glightbox %}
  <script src="/assets/vendor/glightbox.min.js"></script>
  <script>
    const lightbox = GLightbox({
      touchNavigation: true,
      loop: true,
      autoplayVideos: false,
      closeOnOutsideClick: true
    });
  </script>
  {% endif %}

  {# Smooth scroll #}
  <script>
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</body>
</html>
